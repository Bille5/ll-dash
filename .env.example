# Copy this to .env for local development — NEVER commit .env to git.
#
# Almost everything is now configured through the in-app setup wizard on
# first run (team number, PIN, FTC API credentials, branding, theme), so
# the only variable you really need is DATABASE_URL. The rest are optional
# fallbacks: if all four of TEAM_NUMBER / TEAM_PIN / FTC_API_USERNAME /
# FTC_API_KEY are set on first boot, they are imported into the database
# and the setup wizard is skipped (useful for upgrading existing deploys).

# Required: session signing key. Use any long random string.
SECRET_KEY=make-up-any-random-string

# Required: Postgres connection string.
# Render/Heroku set this automatically in production.
DATABASE_URL=postgresql://user:password@localhost/lldash

# ── Optional fallbacks (the setup wizard replaces all of these) ──

# Your FTC team number
#TEAM_NUMBER=3650

# 4-digit PIN that unlocks the dashboard
#TEAM_PIN=1234

# FTC Events API credentials — request free access at
# https://ftc-events.firstinspires.org/services/API
#FTC_API_USERNAME=your-username
#FTC_API_KEY=your-token-here

# Dashboard display name (only used together with the fallbacks above)
#DASHBOARD_NAME=LL Dash
